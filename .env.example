# Earth Environmental Observatory - Environment Configuration Template

# PostgreSQL Database Connection String
# Standard connection URL: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://earth_user:earth_secure_pass@localhost:5432/earth_production

# JWT Session Cookie Secret (minimum 32 characters for HS256)
# Generate a cryptographically secure token using: openssl rand -base64 32
SESSION_SECRET=earth_super_secret_jwt_key_at_least_32_characters_long_for_security

# Application Host URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
