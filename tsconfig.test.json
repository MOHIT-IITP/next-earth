{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@neon/config/*": ["node_modules/@neon/config/dist/*"]
    },
    "outDir": ".test-dist"
  },
  "include": ["src/**/*", "tests/**/*"]
}
